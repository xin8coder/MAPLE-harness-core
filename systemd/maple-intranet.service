[Unit]
Description=MAPLE Harness intranet application
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
WorkingDirectory="@PLUGIN_ROOT@"
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment="MAPLE_HOME=@MAPLE_HOME@"
EnvironmentFile=-"@CONFIG_ROOT@/provider.env"
EnvironmentFile=-"@CONFIG_ROOT@/service.env"
ExecStart="@PLUGIN_ROOT@/scripts/start_intranet.sh"
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
KillMode=control-group
UMask=0077

[Install]
WantedBy=default.target
