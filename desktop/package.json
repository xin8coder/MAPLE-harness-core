{
  "name": "maple-harness-desktop",
  "version": "0.2.0",
  "private": true,
  "description": "Desktop client for an existing MAPLE Harness deployment",
  "author": "Anonymous Authors",
  "license": "ISC",
  "main": "main.cjs",
  "desktopName": "maple-harness.desktop",
  "engines": { "node": "^22.19.0 || >=24.0.0" },
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "26.17.0"
  },
  "build": {
    "appId": "org.maple.harness.desktop",
    "productName": "MAPLE Harness",
    "icon": "icon.png",
    "artifactName": "MAPLE-Harness-${version}-${os}-${arch}.${ext}",
    "files": ["*.cjs", "connection.html", "connection.js", "connection.css", "icon.png", "LICENSE"],
    "linux": { "target": ["AppImage", "tar.gz"], "category": "Office", "icon": "icon.png", "syncDesktopName": true },
    "win": { "target": "nsis" },
    "nsis": { "oneClick": true, "perMachine": false },
    "mac": { "target": ["dmg", "zip"], "category": "public.app-category.productivity" }
  }
}
